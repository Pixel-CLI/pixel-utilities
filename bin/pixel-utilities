#!/bin/sh
# SPDX-FileCopyrightText: The Pixel contributors
# SPDX-License-Identifier: MIT
#
# Launcher for the `git` Pixel plugin: the manifest's `run`. The plugin is the
# Rust binary `pixel-utilities`; this file only finds it and hands over the
# arguments. A release install replaces this file with the binary itself
# (the `pixel-utilities-<target>` release asset).
#
# Looked up in order: $PIXEL_UTILITIES_BIN, $CARGO_HOME/bin (where `cargo install`
# puts it), then PATH. A candidate that is this very file is skipped, so the
# launcher can never exec itself.
for candidate in "${PIXEL_UTILITIES_BIN:-}" "${CARGO_HOME:-$HOME/.cargo}/bin/pixel-utilities" "$(command -v pixel-utilities 2>/dev/null || true)"; do
  if [ -n "$candidate" ] && [ -x "$candidate" ] && ! [ "$candidate" -ef "$0" ]; then
    exec "$candidate" "$@"
  fi
done
cat >&2 <<'MSG'
pixel: the `utilities` plugin has no `pixel-utilities` binary installed. Install it with:
  cargo install --git https://github.com/Pixel-CLI/pixel-utilities pixel-utilities-plugin
MSG
exit 127
